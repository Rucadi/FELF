+#ifdef SHARED
+/* FELF ("fat ELF") executables carry their shared objects inside the file,
+   some of them uncompressed and page-aligned.  FELF's audit module answers
+   a lookup for such an object with FELF_MAP_PREFIX followed by its offset
+   in hexadecimal, and the object is mapped straight from the FELF file,
+   which FELF's bootstrap leaves open on descriptor 999.  The FELF packer
+   looks for FELF_MAP_PREFIX to know that a loader can do this.  */
+# define FELF_MAP_PREFIX "felf-map-1:"
+# define FELF_FILE "/proc/self/fd/999"
+
+/* Map the object TOKEN refers to, requested as NAME.  */
+static struct link_map *
+felf_map_object (struct link_map *loader, const char *name,
+		 const char *token, int type, int mode, Lmid_t nsid)
+{
+  ElfW(Off) offset = 0;
+  const char *p = token + sizeof (FELF_MAP_PREFIX) - 1;
+  int digits = 0;
+  for (; *p != '\0'; ++p, ++digits)
+    {
+      unsigned int d;
+      if (*p >= '0' && *p <= '9')
+	d = *p - '0';
+      else if (*p >= 'a' && *p <= 'f')
+	d = *p - 'a' + 10;
+      else
+	break;
+      offset = offset * 16 + d;
+    }
+  if (*p != '\0' || digits == 0 || digits > 16 || offset == 0
+      || (offset & (GLRO(dl_pagesize) - 1)) != 0)
+    _dl_signal_error (0, name, NULL, N_("invalid FELF object reference"));
+
+  int fd = __open64_nocancel (FELF_FILE, O_RDONLY | O_CLOEXEC);
+  if (fd == -1)
+    _dl_signal_error (errno, name, NULL, N_("cannot open the FELF file"));
+
+  struct filebuf fb;
+  ssize_t n = __pread64_nocancel (fd, fb.buf, sizeof (fb.buf), offset);
+  const ElfW(Ehdr) *ehdr = (const ElfW(Ehdr) *) fb.buf;
+  if (n < (ssize_t) sizeof (ElfW(Ehdr))
+      || memcmp (ehdr->e_ident, ELFMAG, SELFMAG) != 0
+      || ehdr->e_ident[EI_CLASS] != ELFW(CLASS)
+      || ehdr->e_phentsize != sizeof (ElfW(Phdr))
+      || !elf_machine_matches_host (ehdr))
+    {
+      __close_nocancel (fd);
+      _dl_signal_error (0, name, NULL,
+			N_("invalid ELF object in the FELF file"));
+    }
+  fb.len = n;
+
+  char *realname = __strdup (name);
+  if (realname == NULL)
+    {
+      __close_nocancel (fd);
+      _dl_signal_error (ENOMEM, name, NULL,
+			N_("cannot create shared object descriptor"));
+    }
+  /* As in _dl_map_new_object: a dlopen'ed object is its own loader, so its
+     local scope is its own search list.  */
+  if (mode & __RTLD_CALLMAP)
+    loader = NULL;
+  return _dl_map_object_from_fd (name, NULL, fd, &fb, realname, loader,
+				 type, mode, __libc_stack_end, nsid, offset);
+}
+#endif
+
 /* Map in the shared object file NAME.  */
 
 struct link_map *
@@ -1976,6 +2056,10 @@ _dl_map_new_object (struct link_map *loader, const char *name,
       if (before != name && strcmp (before, name) != 0)
 	origname = before;
     }
+
+  if (strncmp (name, FELF_MAP_PREFIX, sizeof (FELF_MAP_PREFIX) - 1) == 0)
+    return felf_map_object (loader, origname != NULL ? origname : name,
+			    name, type, mode, nsid);
 #endif
 
   if (strchr (name, '/') == NULL)
@@ -2197,7 +2281,7 @@ _dl_map_new_object (struct link_map *loader, const char *name,
 
   void *stack_end = __libc_stack_end;
   return _dl_map_object_from_fd (name, origname, fd, &fb, realname, loader,
-				 type, mode, stack_end, nsid);
+				 type, mode, stack_end, nsid, 0);
 }
 
